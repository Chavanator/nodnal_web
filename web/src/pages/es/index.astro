---
import Base from '../../layouts/Base.astro';
import HeroCinema from '../../components/HeroCinema.astro';
import { dict } from '../../i18n/dict';
import { formatEventDate, upcomingEvents } from '../../lib/events';

// Home rediseñado: hero cinematográfico (HeroCinema) + secciones con la
// identidad natural/editorial. Textos provisionales pendientes del cliente.
const t = dict.es;
const upcoming = upcomingEvents().slice(0, 3);
const services = [
  { name: 'Caminatas y travesías guiadas', href: '/es/eventos/', note: 'Salidas de un día y de varios días.' },
  { name: 'Eventos de yoga', href: '/es/eventos/', note: 'Práctica y comunidad al aire libre.' },
  { name: 'Coaching individual', href: '/es/servicios/coaching-individual/', note: 'Acompañamiento 1 a 1 trauma-informado.' },
];
---
<Base
  locale="es"
  currentKey="home"
  title="NODNAL · Naturaleza, yoga y coaching"
  description="Caminatas guiadas, eventos de yoga y coaching individual en Ecuador y Montana. Explora eventos e inscríbete."
  overlayHeader
>
  <HeroCinema locale="es" />

  <section class="sect" aria-labelledby="upcoming">
    <div class="wrap">
      <h2 id="upcoming">{t.home.upcomingTitle}</h2>
      {
        upcoming.length === 0 ? (
          <p class="empty">{t.home.upcomingEmpty}</p>
        ) : (
          <ul class="ev-grid">
            {upcoming.map((ev) => (
              <li>
                <p class="ev-date">{formatEventDate(ev.startAt, ev.timezone, 'es')}</p>
                <a class="ev-title" href={`/es/eventos/${ev.slug}/`}>
                  {ev.text.es.title}
                </a>
                <p class="ev-meta">{ev.text.es.locationName}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="sect" aria-labelledby="services">
    <div class="wrap">
      <h2 id="services">{t.home.servicesTitle}</h2>
      <ul class="svc-list">
        {
          services.map((s) => (
            <li>
              <a href={s.href}>
                <span class="svc-name">{s.name}</span>
                <span class="svc-note">{s.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="sect-cta"><a href="/es/servicios/">{t.home.servicesCta}</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="about-teaser">
    <div class="wrap">
      <h2 id="about-teaser">{t.home.aboutTeaserTitle}</h2>
      <p>
        NODNAL es un recurso para la autotransformación: propuestas formales de artes
        de sanación y un blog personal. Guía certificado en naturaleza, coach
        trauma-informado y practicante de yoga.
      </p>
      <p><a class="band-btn" href="/es/acerca-de/">Acerca de NODNAL</a></p>
    </div>
  </section>

  <style>
    .wrap {
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 1.25rem;
    }
    .sect {
      background: var(--warm-white);
      padding-block: clamp(3.5rem, 7vw, 5.5rem);
    }
    :global([data-theme='dark']) .sect {
      background: var(--forest);
    }
    .sect h2,
    .band h2 {
      font-size: clamp(1.8rem, 3.2vw, 2.5rem);
      margin: 0 0 1.75rem;
      color: var(--forest);
    }
    :global([data-theme='dark']) .sect h2,
    :global([data-theme='dark']) .band h2 {
      color: var(--warm-white);
    }
    .empty {
      border: 1px solid var(--stone);
      background: color-mix(in srgb, var(--stone) 35%, transparent);
      border-radius: var(--radius-small);
      padding: 1rem 1.25rem;
      max-width: 60ch;
      margin: 0;
    }
    :global([data-theme='dark']) .empty {
      border-color: rgba(248, 245, 239, 0.2);
      background: rgba(248, 245, 239, 0.05);
    }
    /* Próximos eventos: entradas editoriales con regla superior, sin tarjetas. */
    .ev-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.75rem 2.25rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
    .ev-grid li {
      display: grid;
      gap: 0.4rem;
      align-content: start;
      border-top: 1px solid var(--stone);
      padding-top: 1.1rem;
    }
    :global([data-theme='dark']) .ev-grid li {
      border-top-color: rgba(248, 245, 239, 0.2);
    }
    .ev-date {
      margin: 0;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--sage-ink);
    }
    .ev-title {
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 2vw, 1.4rem);
      font-weight: 600;
      color: var(--forest);
      text-decoration: none;
      line-height: 1.25;
    }
    :global([data-theme='dark']) .ev-title {
      color: var(--warm-white);
    }
    .ev-title:hover {
      text-decoration: underline;
      text-decoration-color: var(--lavender);
      text-decoration-thickness: 2px;
      text-underline-offset: 5px;
    }
    .ev-meta {
      margin: 0;
      color: var(--sage-ink);
      font-size: 1rem;
    }
    /* Servicios: lista con divisores de piedra. */
    .svc-list {
      list-style: none;
      margin: 0 0 1.25rem;
      padding: 0;
    }
    .svc-list li {
      border-top: 1px solid var(--stone);
    }
    :global([data-theme='dark']) .svc-list li {
      border-top-color: rgba(248, 245, 239, 0.2);
    }
    .svc-list li:last-child {
      border-bottom: 1px solid var(--stone);
    }
    :global([data-theme='dark']) .svc-list li:last-child {
      border-bottom-color: rgba(248, 245, 239, 0.2);
    }
    .svc-list a {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.25rem 1.5rem;
      align-items: baseline;
      padding: 1.2rem 0;
      text-decoration: none;
      color: var(--text);
    }
    .svc-name {
      font-family: var(--font-display);
      font-size: clamp(1.25rem, 2.2vw, 1.5rem);
      font-weight: 600;
      color: var(--forest);
    }
    :global([data-theme='dark']) .svc-name {
      color: var(--warm-white);
    }
    .svc-list a:hover .svc-name {
      text-decoration: underline;
      text-decoration-color: var(--lavender);
      text-decoration-thickness: 2px;
      text-underline-offset: 5px;
    }
    .svc-note {
      color: var(--sage-ink);
      font-size: 1rem;
    }
    .sect-cta {
      margin: 0;
    }
    .sect-cta a {
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--forest);
      text-underline-offset: 5px;
    }
    :global([data-theme='dark']) .sect-cta a {
      color: var(--warm-white);
    }
    .sect-cta a:hover {
      text-decoration-color: var(--lavender);
      text-decoration-thickness: 2px;
    }
    /* Banda Acerca: composición cálida en piedra. */
    .band {
      background: var(--stone);
      padding-block: clamp(3.5rem, 7vw, 5.5rem);
      margin-top: 0;
    }
    :global([data-theme='dark']) .band {
      background: #35473f;
    }
    .band p {
      max-width: 62ch;
      margin: 0 0 1.5rem;
      color: var(--forest);
      font-size: 1.2rem;
      line-height: 1.7;
    }
    :global([data-theme='dark']) .band p {
      color: var(--warm-white);
    }
    .band-btn {
      display: inline-block;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      color: var(--forest);
      border: 2px solid var(--forest);
      border-radius: 999px;
      padding: 0.65rem 1.4rem;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }
    .band-btn:hover {
      background: var(--forest);
      color: var(--warm-white);
    }
    :global([data-theme='dark']) .band-btn {
      color: var(--warm-white);
      border-color: var(--warm-white);
    }
    :global([data-theme='dark']) .band-btn:hover {
      background: var(--warm-white);
      color: var(--forest);
    }
  </style>
</Base>
