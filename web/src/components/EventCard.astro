---
import { formatEventDate, type EventItem } from '../lib/events';
import type { Locale } from '../i18n/dict';

// Tarjeta flyer con reverso por flip de izquierda a derecha (eje vertical).
// El reverso conserva las dimensiones del anverso por apilado en grid.
// Control real <button>, operable con teclado y táctil, sin hover.
// Respeta prefers-reduced-motion. Solo una cara visible para lectores.
interface Props {
  event: EventItem;
  locale: Locale;
  moreInfo: string;
  back: string;
  register: string;
  detailHref: string;
  fullDetail: string;
  demoLabel: string;
}

const { event, locale, moreInfo, back, register, detailHref, fullDetail, demoLabel } = Astro.props;
const t = event.text[locale];
const cardId = `card-${event.slug}`;
---

<article class="flip" data-flip-card id={cardId}>
  <div class="flip-inner">
    <div class="face front" data-face="front">
      <img src={event.flyer} alt={event.flyerAlt[locale]} width="900" height="1200" loading="lazy" />
      <div class="front-body">
        <h2 class="card-title">{t.title}</h2>
        <p class="meta">
          <time datetime={event.startAt}>{formatEventDate(event.startAt, event.timezone, locale)}</time>
          <span>{t.locationName}</span>
        </p>
        <p class="summary">{t.summary}</p>
        <p class="row">
          <button type="button" class="btn-ghost" data-flip-btn aria-expanded="false" aria-controls={`${cardId}-back`}>
            {moreInfo}
          </button>
          <a class="detail-link" href={detailHref}>{fullDetail}</a>
        </p>
      </div>
    </div>
    <div class="face back" data-face="back" id={`${cardId}-back`} hidden>
      <div class="back-body">
        <h2 class="card-title">{t.title}</h2>
        <p class="price">
          {event.priceAmount > 0 ? `${event.priceAmount} ${event.currency}` : '—'}
          {event.demo && <span class="demo-badge">{demoLabel}</span>}
        </p>
        <ul class="includes">
          {t.includes.map((item) => <li>{item}</li>)}
        </ul>
        <p class="row">
          <button
            type="button"
            class="btn-primary"
            data-register-btn
            data-event-slug={event.slug}
            data-event-title={t.title}
          >
            {register}
          </button>
          <button type="button" class="btn-ghost" data-flip-btn aria-expanded="true">
            {back}
          </button>
        </p>
        <p><a class="detail-link" href={detailHref}>{fullDetail}</a></p>
      </div>
    </div>
  </div>
</article>

<script>
  // Delegación idempotente: una tarjeta puede instanciarse varias veces.
  if (!document.documentElement.hasAttribute('data-flip-bound')) {
    document.documentElement.setAttribute('data-flip-bound', '');
    document.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('[data-flip-btn]');
      if (!btn) return;
      const card = btn.closest('[data-flip-card]');
      if (!card) return;
      const flipped = card.classList.toggle('flipped');
      const front = card.querySelector('[data-face="front"]');
      const backEl = card.querySelector('[data-face="back"]');
      if (front && backEl) {
        if (flipped) {
          front.setAttribute('hidden', '');
          backEl.removeAttribute('hidden');
        } else {
          backEl.setAttribute('hidden', '');
          front.removeAttribute('hidden');
        }
      }
      card.querySelectorAll('[data-flip-btn]').forEach((b) => {
        b.setAttribute('aria-expanded', flipped ? 'true' : 'false');
      });
    });
  }
</script>

<style>
  .flip {
    perspective: 1200px;
  }
  .flip-inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    display: grid;
  }
  .flip.flipped .flip-inner {
    transform: rotateY(-180deg);
  }
  .face {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    width: 100%;
    height: 100%;
  }
  .face.back {
    transform: rotateY(180deg);
  }
  .face[hidden] {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }
  .front img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  .front-body,
  .back-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .card-title {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }
  .meta {
    display: grid;
    gap: 0.15rem;
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0 0 0.6rem;
  }
  .meta time {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-ink);
  }
  .summary {
    margin: 0 0 1rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 0.6rem;
  }
  .btn-ghost {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--brand-ink);
    background: transparent;
    border: 2px solid var(--brand);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn-primary {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    background: var(--brand);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    white-space: nowrap;
  }
  [data-theme='dark'] .btn-primary {
    color: var(--on-brand);
  }
  .btn-primary:active,
  .detail-link {
    font-size: 0.95rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .demo-badge {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: var(--surface-warm);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }
  .includes {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-inner {
      transition: none;
    }
    .flip.flipped .flip-inner {
      transform: none;
    }
    .flip .face.back {
      transform: none;
      display: none;
    }
    .flip.flipped .face.back {
      display: block;
    }
    .flip.flipped .face.front {
      display: none;
    }
  }
</style>
