---
// Iconos vectoriales mínimos por servicio (trazos, currentColor).
interface Props {
  name: 'hike' | 'yoga' | 'coaching';
}
const { name } = Astro.props;
---

<svg class="service-svg" width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'hike' && (
      <g>
        <path d="M5 37 L17 15 L25 27 L31 19 L43 37 Z" />
        <circle cx="35" cy="11" r="4" />
      </g>
    )
  }
  {
    name === 'yoga' && (
      <g>
        <circle cx="24" cy="11" r="5" />
        <path d="M13 27 q11 -7 22 0" />
        <path d="M10 38 q14 -11 28 0" />
      </g>
    )
  }
  {
    name === 'coaching' && (
      <g>
        <path d="M24 7 L34 25 H14 Z" />
        <path d="M24 21 L33 37 H15 Z" />
        <path d="M24 37 v5" />
      </g>
    )
  }
</svg>

<style>
  .service-svg {
    display: block;
    color: var(--brand);
  }
</style>
