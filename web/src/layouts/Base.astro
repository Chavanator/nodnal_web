---
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/buttons.css';
import { dict, type Locale } from '../i18n/dict';
import { equivalentPath, mainNavSync } from '../i18n/routing';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentKey?: string;
  noindex?: boolean;
  /** El header se superpone transparente sobre el hero de video (home). */
  overlayHeader?: boolean;
}

const { locale, title, description, currentKey, noindex, overlayHeader } = Astro.props;
const t = dict[locale];
const nav = mainNavSync(locale);
const other: Locale = locale === 'es' ? 'en' : 'es';
const switchHref = equivalentPath(Astro.url.pathname, other);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.nodnal.com').href;
const altHref = new URL(switchHref, Astro.site ?? 'https://www.nodnal.com').href;
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={altHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_EC' : 'en_US'} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Tema inicial sin FOUC: preferencia guardada, si no la del sistema.
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('nodnal-theme');
        var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">{t.skipToContent}</a>

    <header class:list={['site-header', { 'over-hero': overlayHeader }]}>
      <div class="wrap header-inner">
        <a class="brand" href={locale === 'es' ? '/es/' : '/en/'} aria-label="NODNAL">NODNAL</a>
        <button class="menu-btn" data-fill type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.nav.menuLabel}>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <nav id="primary-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === currentKey ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-actions">
          <a class="lang-toggle" data-fill href={switchHref} hreflang={other} aria-label={t.language.toggle}>
            {other.toUpperCase()}
          </a>
          <button class="theme-toggle" data-fill type="button" aria-label={t.theme.toggle}>
            <!-- Iconos Phosphor Icons (ISC): sol en tema claro, luna en oscuro -->
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0,16Z" /></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z" /></svg>
          </button>
          <a class="cta" href={locale === 'es' ? '/es/eventos/' : '/en/events/'}>{t.nav.cta}</a>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid" data-reveal>
        <div>
          <p class="brand">NODNAL</p>
          <p>{t.footer.tagline}</p>
        </div>
        <nav aria-label="Secondary">
          <p class="footer-title">{t.footer.navTitle}</p>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="footer-contact">
          <p class="footer-title">{t.footer.contactTitle}</p>
          <p>
            <a class="contact-link" href={`mailto:${t.footer.email}`}>
              <!-- Icono Phosphor (ISC): sobre -->
              <svg width="17" height="17" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM203.43,64,128,133.15,52.57,64ZM216,192H40V74.19l80.11,73.34a8,8,0,0,0,10.78,0L216,74.19Z" /></svg>
              <span>{t.footer.email}</span>
            </a>
          </p>
          <p>
            <a class="contact-link" href="tel:+14067179129">
              <!-- Icono Phosphor (ISC): teléfono -->
              <svg width="17" height="17" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.54c.2-.25.39-.5.56-.75a16,16,0,0,0,1.4-15.17l0-.13L117.54,33.6a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,56,80c0,97.2,78.8,176,176,176a56.26,56.26,0,0,0,55.94-44.92A16,16,0,0,0,222.37,158.46Z" /></svg>
              <span>{t.footer.phone}</span>
            </a>
          </p>
        </div>
      </div>
      <div class="wrap footer-base">
        <p>© NODNAL. {t.footer.rights}</p>
        <p>{t.footer.legalPending}</p>
      </div>
    </footer>

    <script is:inline>
      // Preferencias persistentes: tema e idioma (CONTENT_AND_I18N).
      (function () {
        var root = document.documentElement;
        var themeBtn = document.querySelector('.theme-toggle');
        function paintTheme() {
          var dark = root.dataset.theme === 'dark';
          if (themeBtn) themeBtn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        }
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('nodnal-theme', next);
            } catch (e) {}
            paintTheme();
          });
        }
        paintTheme();
        try {
          var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
          localStorage.setItem('nodnal-locale', lang);
        } catch (e) {}
        var menuBtn = document.querySelector('.menu-btn');
        var nav = document.getElementById('primary-nav');
        if (menuBtn && nav) {
          menuBtn.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        // Header sobre hero de video: transparente arriba, sólido al desplazar.
        var overHero = document.querySelector('.site-header.over-hero');
        if (overHero) {
          var pending = false;
          var syncHeader = function () {
            pending = false;
            overHero.classList.toggle('scrolled', window.scrollY > 32);
          };
          window.addEventListener(
            'scroll',
            function () {
              if (!pending) {
                pending = true;
                window.requestAnimationFrame(syncHeader);
              }
            },
            { passive: true },
          );
          syncHeader();
        }
        // Revelado al entrar en viewport: [data-reveal] → .is-in (motion.css).
        var revealEls = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('is-in');
                  io.unobserve(en.target);
                }
              });
            },
            { threshold: 0, rootMargin: '0px 0px -40px 0px' },
          );
          revealEls.forEach(function (el) {
            io.observe(el);
          });
        } else {
          revealEls.forEach(function (el) {
            el.classList.add('is-in');
          });
        }
      })();
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--brand);
        color: var(--on-brand);
        padding: 0.5rem 1rem;
        z-index: 100;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
      .wrap {
        max-width: 72rem;
        margin-inline: auto;
        padding-inline: 1.25rem;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: var(--z-nav);
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        transition:
          background-color 0.4s ease,
          border-color 0.4s ease,
          backdrop-filter 0.4s ease;
      }
      /* Header superpuesto al hero de video: transparente, texto claro.
       * Al desplazar (>32px) recupera fondo sólido y colores del tema. */
      .site-header.over-hero {
        position: fixed;
        left: 0;
        right: 0;
        background: transparent;
        border-bottom-color: transparent;
        backdrop-filter: none;
      }
      .site-header.over-hero .brand,
      .site-header.over-hero #primary-nav a,
      .site-header.over-hero .lang-toggle,
      .site-header.over-hero .theme-toggle,
      .site-header.over-hero .menu-btn {
        color: var(--warm-white);
        border-color: rgba(248, 245, 239, 0.45);
        text-shadow: 0 1px 12px rgba(16, 24, 20, 0.4);
      }
      .site-header.over-hero #primary-nav a[aria-current='page'] {
        color: var(--lavender);
        text-decoration-color: var(--lavender);
      }
      /* Menú móvil abierto: el panel es sólido, así que recupera colores
       * del tema (si no, los enlaces quedarían warm-white sobre surface). */
      .site-header.over-hero #primary-nav.open {
        background: var(--surface);
        border-bottom: 1px solid var(--line);
      }
      .site-header.over-hero #primary-nav.open a {
        color: var(--text);
        text-shadow: none;
      }
      .site-header.over-hero #primary-nav.open a[aria-current='page'] {
        color: var(--brand-ink);
        text-decoration-color: currentColor;
      }
      .site-header.over-hero .cta {
        background: var(--warm-white);
        color: var(--forest);
        text-shadow: none;
      }
      .site-header.over-hero .menu-btn span[aria-hidden='true'] {
        background: var(--warm-white);
      }
      /* Relleno morado (buttons.css): al hacer hover el texto pasa a
       * on-brand para mantener contraste sobre el fondo lleno. */
      .site-header.over-hero .lang-toggle:hover,
      .site-header.over-hero .lang-toggle:focus-visible,
      .site-header.over-hero .theme-toggle:hover,
      .site-header.over-hero .theme-toggle:focus-visible,
      .site-header.over-hero .menu-btn:hover,
      .site-header.over-hero .menu-btn:focus-visible {
        color: var(--on-brand);
        border-color: var(--brand);
        text-shadow: none;
      }
      .site-header.over-hero.scrolled {
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        border-bottom-color: var(--line);
        backdrop-filter: blur(8px);
      }
      .site-header.over-hero.scrolled .brand,
      .site-header.over-hero.scrolled #primary-nav a,
      .site-header.over-hero.scrolled .lang-toggle,
      .site-header.over-hero.scrolled .theme-toggle,
      .site-header.over-hero.scrolled .menu-btn {
        color: var(--text);
        border-color: var(--line);
        text-shadow: none;
      }
      .site-header.over-hero.scrolled #primary-nav a[aria-current='page'] {
        color: var(--brand-ink);
        text-decoration-color: currentColor;
      }
      .site-header.over-hero.scrolled .cta {
        background: var(--brand);
        color: var(--on-brand);
      }
      .site-header.over-hero.scrolled .menu-btn span[aria-hidden='true'] {
        background: currentColor;
      }
      .site-header.over-hero.scrolled .lang-toggle:hover,
      .site-header.over-hero.scrolled .lang-toggle:focus-visible,
      .site-header.over-hero.scrolled .theme-toggle:hover,
      .site-header.over-hero.scrolled .theme-toggle:focus-visible,
      .site-header.over-hero.scrolled .menu-btn:hover,
      .site-header.over-hero.scrolled .menu-btn:focus-visible {
        color: var(--on-brand);
        border-color: var(--brand);
        text-shadow: none;
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        min-height: 68px;
      }
      .brand {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: 0.08em;
        color: var(--text);
        text-decoration: none;
      }
      #primary-nav ul {
        display: flex;
        gap: 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      #primary-nav a {
        position: relative;
        font-family: var(--font-ui);
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      /* Subrayado animado de izquierda a derecha en hover/focus. */
      #primary-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -6px;
        height: 2px;
        border-radius: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.3s ease;
      }
      #primary-nav a:hover::after,
      #primary-nav a:focus-visible::after {
        transform: scaleX(1);
      }
      #primary-nav a[aria-current='page'] {
        color: var(--brand-ink);
        text-decoration: none;
      }
      #primary-nav a[aria-current='page']::after {
        transform: scaleX(1);
      }
      .header-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .lang-toggle {
        font-family: var(--font-ui);
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        color: var(--text);
        text-decoration: none;
      }
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        padding: 0;
      }
      .theme-toggle .icon-moon { display: none; }
      [data-theme='dark'] .theme-toggle .icon-sun { display: none; }
      [data-theme='dark'] .theme-toggle .icon-moon { display: block; }
      .cta {
        font-family: var(--font-ui);
        font-size: 0.9rem;
        font-weight: 600;
        background: var(--brand);
        color: #fff;
        text-decoration: none;
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        white-space: nowrap;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }
      [data-theme='dark'] .cta {
        color: var(--on-brand);
      }
      .cta:hover,
      .cta:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -12px rgba(125, 42, 209, 0.8);
      }
      .cta:active {
        transform: translateY(1px) scale(0.97);
      }
      @media (prefers-reduced-motion: reduce) {
        .cta {
          transition: none;
        }
        .cta:hover,
        .cta:focus-visible,
        .cta:active {
          transform: none;
          box-shadow: none;
        }
      }
      .menu-btn {
        display: none;
      }
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: 4rem;
        padding: 2.5rem 0 1.5rem;
      }
      .contact-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .contact-link svg {
        flex-shrink: 0;
        opacity: 0.75;
        transition:
          transform 0.25s ease,
          opacity 0.25s ease;
      }
      .contact-link:hover svg {
        opacity: 1;
        transform: translateX(2px);
      }
      .footer-grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: 1.2fr 1fr 1fr;
      }
      .footer-grid ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.4rem;
      }
      .footer-title {
        font-family: var(--font-ui);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0 0 0.6rem;
      }
      .footer-base {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        margin-top: 2rem;
        font-size: 0.95rem;
        color: var(--text-muted);
      }
      @media (max-width: 1023px) {
        #primary-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: var(--surface);
          border-bottom: 1px solid var(--line);
          padding: 0.5rem 1.25rem 1rem;
        }
        #primary-nav.open {
          display: block;
        }
        #primary-nav ul {
          flex-direction: column;
          gap: 0.7rem;
        }
        .menu-btn {
          display: inline-flex;
          flex-direction: column;
          justify-content: center;
          gap: 4px;
          background: transparent;
          border: 1px solid var(--line);
          border-radius: var(--radius-small);
          color: var(--text);
          padding: 0.6rem 0.7rem;
          cursor: pointer;
          font-family: var(--font-ui);
          font-size: 0.85rem;
        }
        .menu-btn span[aria-hidden='true'] {
          display: block;
          width: 18px;
          height: 2px;
          background: currentColor;
          border-radius: 1px;
        }
        .header-inner {
          flex-wrap: wrap;
        }
        .footer-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
